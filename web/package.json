{
  "name": "justiceflow-web",
  "version": "0.1.0",
  "description": "Caseworker interface for the JusticeFlow synthetic justice triage demonstration",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "22.23.3",
    "npm": "12.2.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
