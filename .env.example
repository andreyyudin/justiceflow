POSTGRES_DB=justiceflow
POSTGRES_USER=justiceflow
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=local
JUSTICEFLOW_RELEASE=development
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-local-admin-password
OIDC_ISSUER=http://localhost:8080/realms/justiceflow
OIDC_AUDIENCE=justiceflow-api
OIDC_JWKS_URL=http://identity:8080/realms/justiceflow/protocol/openid-connect/certs
PUBLIC_API_URL=http://localhost:8000
PUBLIC_OIDC_AUTHORITY=http://localhost:8080/realms/justiceflow
PUBLIC_OIDC_CLIENT_ID=justiceflow-web
IDENTITY_PORT=8080
API_PORT=8000
WEB_PORT=3000
